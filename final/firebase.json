{
  "hosting": {
    "public": "website",
    "ignore": [],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.{js,css,png,jpg,jfif,svg,webp}",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=3600" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
